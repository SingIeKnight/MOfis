<Window x:Class="MOfis.Shell.StartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MOfis" Width="1100" Height="720" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{StaticResource TextBrush}" Background="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sol menu -->
        <Border Background="#312E81">
            <DockPanel Margin="0,22,0,16">
                <StackPanel DockPanel.Dock="Top" Margin="22,0,0,28" Orientation="Horizontal">
                    <Border Width="30" Height="30" CornerRadius="7" Background="White">
                        <TextBlock Text="M" FontWeight="Bold" FontSize="18" Foreground="#312E81" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="MOfis" Foreground="White" FontSize="19" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" Foreground="#A5B4FC" FontSize="11" Margin="22,0,0,0"/>
                <StackPanel>
                    <Button x:Name="NavNewDoc" Style="{StaticResource TileButton}" Foreground="White" Padding="22,10" Click="NewDocument_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Yeni belge" Margin="12,0,0,0" FontSize="14"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TileButton}" Foreground="White" Padding="22,10" Click="Open_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Aç" Margin="12,0,0,0" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Ana alan -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,30,40,30">
                <TextBlock x:Name="Greeting" FontSize="26" FontWeight="SemiBold"/>

                <TextBlock Text="Yeni" FontSize="16" FontWeight="SemiBold" Margin="0,26,0,10"/>
                <WrapPanel>
                    <Button Style="{StaticResource TileButton}" Padding="10" Margin="0,0,14,0" Click="NewDocument_Click" ToolTip="Boş bir belge oluştur (Ctrl+N)">
                        <StackPanel>
                            <Border Width="128" Height="164" Background="White" BorderBrush="#D6D7DE" BorderThickness="1" CornerRadius="3">
                                <StackPanel Margin="16,22,16,0">
                                    <Border Height="7" Background="#C7CBF5" CornerRadius="2" Width="60" HorizontalAlignment="Left"/>
                                    <Border Height="4" Background="#E3E4EA" CornerRadius="2" Margin="0,12,0,0"/>
                                    <Border Height="4" Background="#E3E4EA" CornerRadius="2" Margin="0,6,0,0"/>
                                    <Border Height="4" Background="#E3E4EA" CornerRadius="2" Margin="0,6,0,0"/>
                                    <Border Height="4" Background="#E3E4EA" CornerRadius="2" Margin="0,6,30,0"/>
                                    <Border Height="4" Background="#E3E4EA" CornerRadius="2" Margin="0,14,0,0"/>
                                    <Border Height="4" Background="#E3E4EA" CornerRadius="2" Margin="0,6,0,0"/>
                                    <Border Height="4" Background="#E3E4EA" CornerRadius="2" Margin="0,6,18,0"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Boş belge" Margin="2,8,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TileButton}" Padding="10" IsEnabled="False" ToolTip="Hesap tablosu bir sonraki sürümde geliyor">
                        <StackPanel>
                            <Border Width="128" Height="164" Background="White" BorderBrush="#D6D7DE" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                                <Grid x:Name="SheetThumb" Margin="8,14,8,8"/>
                            </Border>
                            <TextBlock Text="Boş tablo (yakında)" Margin="2,8,0,0"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <StackPanel x:Name="RecoveryPanel" Visibility="Collapsed">
                    <TextBlock Text="Kurtarılan belgeler" FontSize="16" FontWeight="SemiBold" Margin="0,28,0,4"/>
                    <TextBlock Text="Program beklenmedik şekilde kapandığında kaydedilmemiş belgelerin otomatik kopyaları." Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,8"/>
                    <StackPanel x:Name="RecoveryList"/>
                </StackPanel>

                <TextBlock Text="Son kullanılanlar" FontSize="16" FontWeight="SemiBold" Margin="0,28,0,8"/>
                <StackPanel x:Name="RecentList"/>
                <TextBlock x:Name="RecentEmpty" Text="Henüz açılan dosya yok. Açtığınız belgeler burada listelenir."
                           Foreground="{StaticResource SubtleTextBrush}" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
