<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Windows'ta hazir gelen sistem fontlari kullanilir; hicbir font pakete konmaz. -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>

    <!-- Uygulamanin kendi rengi: indigo. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4338CA"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#3730A3"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#E0E7FF"/>
    <SolidColorBrush x:Key="RibbonBg" Color="#F7F7F9"/>
    <SolidColorBrush x:Key="TabRowBg" Color="#F7F7F9"/>
    <SolidColorBrush x:Key="HoverBg" Color="#E6E6EC"/>
    <SolidColorBrush x:Key="PressedBg" Color="#D3D3DC"/>
    <SolidColorBrush x:Key="CheckedBg" Color="#D9DCF0"/>
    <SolidColorBrush x:Key="LineBrush" Color="#E1E1E7"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1F2328"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#5F6670"/>
    <SolidColorBrush x:Key="CanvasBg" Color="#E8E9EE"/>
    <SolidColorBrush x:Key="StatusBg" Color="#F1F1F4"/>
    <SolidColorBrush x:Key="InfoBarBg" Color="#FFF4CE"/>
    <SolidColorBrush x:Key="InfoBarLine" Color="#F2D675"/>

    <!-- Buyuk serit dugmesi: ustte ikon (Tag), altta yazi (Content). -->
    <Style x:Key="RibbonLarge" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="MinWidth" Value="50"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="1">
                        <StackPanel>
                            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource IconFont}"
                                       FontSize="24" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,3"/>
                            <ContentPresenter HorizontalAlignment="Center" TextBlock.FontSize="11.5" TextBlock.TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBg}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource PressedBg}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Kucuk serit dugmesi: solda ikon (Tag; bossa gizli), sagda istege bagli yazi. -->
    <Style x:Key="RibbonSmall" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="MinWidth" Value="26"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}" Margin="1,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="icon" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource IconFont}"
                                       FontSize="15" VerticalAlignment="Center"/>
                            <ContentPresenter x:Name="cp" VerticalAlignment="Center" Margin="5,0,0,0" TextBlock.FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}"><Setter TargetName="icon" Property="Visibility" Value="Collapsed"/><Setter TargetName="cp" Property="Margin" Value="0"/></Trigger>
                        <Trigger Property="Content" Value="{x:Null}"><Setter TargetName="cp" Property="Visibility" Value="Collapsed"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBg}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource PressedBg}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RibbonToggle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="MinWidth" Value="26"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}" Margin="1,0">
                        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="icon" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource IconFont}"
                                       FontSize="15" VerticalAlignment="Center"/>
                            <ContentPresenter x:Name="cp" VerticalAlignment="Center" TextBlock.FontSize="14"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}"><Setter TargetName="icon" Property="Visibility" Value="Collapsed"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBg}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource CheckedBg}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource PressedBg}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Serit grubu: icerik + altta grup adi + sagda ince ayirici cizgi. -->
    <Style x:Key="RibbonGroup" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="6,0,6,0" Margin="0,3">
                        <DockPanel>
                            <ContentPresenter DockPanel.Dock="Bottom" ContentSource="Header" HorizontalAlignment="Center"
                                              TextBlock.Foreground="{StaticResource SubtleTextBrush}" TextBlock.FontSize="11" Margin="0,2,0,0"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Serit sekmeleri: Tag'e konan icerik (Dosya dugmesi) sekmelerin soluna yerlesir. -->
    <Style x:Key="RibbonTabs" TargetType="TabControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Background="{StaticResource TabRowBg}">
                            <ContentPresenter DockPanel.Dock="Left" Content="{TemplateBinding Tag}" VerticalAlignment="Center"/>
                            <TabPanel IsItemsHost="True" Margin="6,0,0,0"/>
                        </DockPanel>
                        <Border Grid.Row="1" Background="{StaticResource RibbonBg}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1" Height="96">
                            <ContentPresenter ContentSource="SelectedContent" Margin="4,0"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RibbonTab" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="bd" Background="Transparent" Padding="12,6,12,4" CornerRadius="3,3,0,0">
                        <StackPanel>
                            <ContentPresenter ContentSource="Header" TextBlock.FontSize="12.5" HorizontalAlignment="Center"/>
                            <Border x:Name="bar" Height="3" CornerRadius="1.5" Margin="2,3,2,0" Background="Transparent"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBg}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bar" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="14,5"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource AccentDarkBrush}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlainButton" TargetType="Button">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="#C9CAD2"/>
        <Setter Property="Padding" Value="14,5"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBg}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TileButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBg}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
</ResourceDictionary>
