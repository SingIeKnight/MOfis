<Window x:Class="MOfis.Sheet.SheetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MOfis.Sheet"
        Title="MOfis Hesap" Width="1240" Height="820" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="12.5"
        Foreground="{StaticResource TextBrush}" Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================== Serit ============================== -->
        <TabControl x:Name="Ribbon" Style="{StaticResource RibbonTabs}" Focusable="False">
            <TabControl.Tag>
                <StackPanel Orientation="Horizontal" Margin="6,3,0,3">
                    <Button x:Name="FileButton" Style="{StaticResource AccentButton}" Content="Dosya" Padding="16,4" Click="FileButton_Click" Focusable="False"/>
                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE74E;" ToolTip="Kaydet (Ctrl+S)" Click="Save_Click" Margin="6,0,0,0" Focusable="False"/>
                    <Button x:Name="UndoBtn" Style="{StaticResource RibbonSmall}" Tag="&#xE7A7;" ToolTip="Geri al (Ctrl+Z)" Click="Undo_Click" Focusable="False"/>
                    <Button x:Name="RedoBtn" Style="{StaticResource RibbonSmall}" Tag="&#xE7A6;" ToolTip="Yinele (Ctrl+Y)" Click="Redo_Click" Focusable="False"/>
                </StackPanel>
            </TabControl.Tag>

            <TabItem Header="Giriş" Style="{StaticResource RibbonTab}">
                <StackPanel Orientation="Horizontal">
                    <HeaderedContentControl Header="Pano" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonLarge}" Tag="&#xE77F;" Content="Yapıştır" ToolTip="Yapıştır (Ctrl+V)" Click="Paste_Click" Focusable="False"/>
                            <StackPanel VerticalAlignment="Center">
                                <Button Style="{StaticResource RibbonSmall}" Tag="&#xE8C6;" Content="Kes" ToolTip="Kes (Ctrl+X)" HorizontalAlignment="Left" Click="Cut_Click" Focusable="False"/>
                                <Button Style="{StaticResource RibbonSmall}" Tag="&#xE8C8;" Content="Kopyala" ToolTip="Kopyala (Ctrl+C)" HorizontalAlignment="Left" Click="Copy_Click" Focusable="False"/>
                            </StackPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Düzenleme" Style="{StaticResource RibbonGroup}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonLarge}" Tag="&#xE8EF;" Content="Otomatik Toplam" ToolTip="Üstteki ya da soldaki sayıların toplamını ekler" Click="AutoSum_Click" Focusable="False"/>
                            <StackPanel VerticalAlignment="Center">
                                <Button Style="{StaticResource RibbonSmall}" Tag="&#xE75C;" Content="İçeriği temizle" ToolTip="Seçili hücrelerin içeriğini siler (Delete)" HorizontalAlignment="Left" Click="Clear_Click" Focusable="False"/>
                                <Button Style="{StaticResource RibbonSmall}" Tag="&#xE710;" Content="Yeni sayfa" ToolTip="Çalışma kitabına sayfa ekler (Shift+F11)" HorizontalAlignment="Left" Click="AddSheet_Click" Focusable="False"/>
                            </StackPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- ============================== Bilgi cubugu ============================== -->
        <Border x:Name="InfoBar" Grid.Row="1" Background="{StaticResource InfoBarBg}" BorderBrush="{StaticResource InfoBarLine}" BorderThickness="0,0,0,1" Visibility="Collapsed">
            <DockPanel Margin="12,6">
                <Button DockPanel.Dock="Right" Style="{StaticResource RibbonSmall}" Tag="&#xE711;" ToolTip="Kapat" Click="CloseInfo_Click" Focusable="False"/>
                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Foreground="#9A6700"/>
                <TextBlock x:Name="InfoText" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- ============================== Formul cubugu ============================== -->
        <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Background="White">
            <DockPanel Margin="6,4">
                <TextBox x:Name="NameBox" Width="96" DockPanel.Dock="Left" VerticalContentAlignment="Center" Padding="4,2"
                         BorderBrush="{StaticResource LineBrush}" ToolTip="Ad kutusu: bir adres yazıp Enter'a basın (ör. B12 veya A1:C5)"/>
                <TextBlock Text="fx" DockPanel.Dock="Left" FontStyle="Italic" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}"
                           VerticalAlignment="Center" Margin="12,0,10,0"/>
                <TextBox x:Name="FormulaBox" VerticalContentAlignment="Center" Padding="4,2" BorderBrush="{StaticResource LineBrush}"
                         AcceptsReturn="False" FontFamily="Consolas, Segoe UI" FontSize="13"/>
            </DockPanel>
        </Border>

        <!-- ============================== Izgara ============================== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <local:SheetGrid x:Name="View"/>
            <Canvas x:Name="EditLayer" ClipToBounds="True">
                <TextBox x:Name="CellEditor" Visibility="Collapsed" BorderThickness="2" BorderBrush="{StaticResource AccentBrush}"
                         Padding="1,0" AcceptsReturn="False" AcceptsTab="False" VerticalContentAlignment="Bottom"/>
            </Canvas>
            <ScrollBar x:Name="VScroll" Grid.Column="1" Orientation="Vertical" Minimum="1" SmallChange="1"/>
            <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource StatusBg}">
                <ScrollBar x:Name="HScroll" DockPanel.Dock="Right" Orientation="Horizontal" Width="320" Minimum="1" SmallChange="1"/>
                <StackPanel Orientation="Horizontal">
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" MaxWidth="900">
                        <StackPanel x:Name="SheetTabs" Orientation="Horizontal" Margin="4,0,0,0"/>
                    </ScrollViewer>
                    <Button Style="{StaticResource RibbonSmall}" Tag="&#xE710;" ToolTip="Yeni sayfa (Shift+F11)" Click="AddSheet_Click" Focusable="False" Margin="4,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- ============================== Durum cubugu ============================== -->
        <Border Grid.Row="4" Background="{StaticResource StatusBg}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="10,3" LastChildFill="False">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Text="Hazır"/>
                <TextBlock x:Name="ZoomText" DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"/>
                <Slider x:Name="ZoomSlider" DockPanel.Dock="Right" Width="130" Minimum="25" Maximum="400" Value="100" VerticalAlignment="Center"
                        IsMoveToPointEnabled="True" Focusable="False" ToolTip="Yakınlaştırma"/>
                <TextBlock x:Name="SumText" DockPanel.Dock="Right" Margin="0,0,24,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
